# ═══════════════════════════════════════════════════════════════
# Student Marketplace Hub — Server Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.

# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Client URL ───────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/student-marketplace?retryWrites=true&w=majority

# ─── JWT Secrets ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-here-change-this
JWT_REFRESH_SECRET=your-refresh-secret-here-change-this

# ─── Email (SMTP) ────────────────────────────────────────────
# Leave blank to use console logging in development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@studentmarketplace.app

# ─── Cloudinary (Image Uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Payment: Paystack ───────────────────────────────────────
# Get your keys at https://dashboard.paystack.com/#/settings/developers
# Use test keys (sk_test_...) in development, live keys (sk_live_...) in production
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# ─── Escrow & Payout Automation ──────────────────────────────
# Duration (in hours) to hold escrow funds before automated seller payout (default: 24)
ESCROW_HOLD_HOURS=24

# Cron schedule for automated payout worker (default: every 10 minutes)
PAYOUT_CRON_SCHEDULE=*/10 * * * *
