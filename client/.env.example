# CampusMarket Client — Environment Variables Example
# Copy this file to .env and fill in your actual production values

# Backend API base URL
# In development: http://localhost:5000/api
# In production: https://your-backend-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Paystack Public Key — Get from https://dashboard.paystack.com/#/settings/developers
# Use pk_test_... in development, pk_live_... in production
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
